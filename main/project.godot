; TURN unified game.
config_version=5

[application]
config/name="TURN"
run/main_scene="res://ui/menu/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[autoload]
TurnSession="*res://core/session.gd"
TurnEnemyAudio="*res://core/enemy_audio.gd"

[display]
window/size/mode=3
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/ssao/half_size=true
environment/ssao/quality=1
global_illumination/voxel_gi/quality=0
environment/defaults/default_clear_color=Color(0.031, 0.045, 0.063, 1)
