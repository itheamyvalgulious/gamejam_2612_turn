<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TURN" Width="880" Height="560" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" FontFamily="Microsoft YaHei UI" Foreground="#F1EFFA">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#100E1D" Offset="0"/>
            <GradientStop Color="#171325" Offset="0.55"/>
            <GradientStop Color="#251739" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Border BorderBrush="#62436F" BorderThickness="1" Margin="28" IsHitTestVisible="False"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
            <TextBlock Text="TURN" FontFamily="Segoe UI" FontSize="108" FontWeight="Black"
                       HorizontalAlignment="Center" Margin="0,0,0,27"/>
            <Canvas x:Name="LoadingTrack" Width="286" Height="3" ClipToBounds="True" Background="#4B3658">
                <Rectangle Width="74" Height="3">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00EFA4E5" Offset="0"/>
                            <GradientStop Color="#FFEFA4E5" Offset="0.55"/>
                            <GradientStop Color="#00EFA4E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform X="-74"/>
                    </Rectangle.RenderTransform>
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                     From="-74" To="286" Duration="0:0:1.1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
            </Canvas>
            <TextBlock x:Name="StatusText" Text="正在准备游戏资源" HorizontalAlignment="Center"
                       Foreground="#B9B5CE" FontSize="17" Margin="0,18,0,0"/>
            <TextBlock x:Name="ErrorDetail" Visibility="Collapsed" FontSize="13" Foreground="#FFBD82"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
        <Button x:Name="CloseButton" AutomationProperties.Name="关闭"
                HorizontalAlignment="Right" VerticalAlignment="Top" Width="44" Height="44"
                Margin="0,39,39,0" BorderBrush="#AB756984" ToolTip="关闭启动窗口">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DC151524" Offset="0"/>
                    <GradientStop Color="#DC282136" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Path x:Name="ClosePlate" Data="M 7.5,0.5 L 43.5,0.5 L 36.5,43.5 L 0.5,43.5 Z"
                              Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}"
                              StrokeThickness="1" IsHitTestVisible="False"/>
                        <Path x:Name="CloseSignal" Data="M 5,42.5 L 31,42.5"
                              StrokeThickness="2" Opacity="0" IsHitTestVisible="False">
                            <Path.Stroke>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFEFA4E5" Offset="0"/>
                                    <GradientStop Color="#59EFA4E5" Offset="1"/>
                                </LinearGradientBrush>
                            </Path.Stroke>
                        </Path>
                        <Path Data="M 17,17 L 27,27 M 27,17 L 17,27" Stroke="#F1EFFA"
                              StrokeThickness="1.75" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ClosePlate" Property="Stroke" Value="#C47EC4"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ClosePlate" Property="Fill" Value="#392747"/>
                            <Setter TargetName="ClosePlate" Property="Stroke" Value="#EFA4E5"/>
                            <Setter TargetName="CloseSignal" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ClosePlate" Property="Fill" Value="#281834"/>
                            <Setter TargetName="ClosePlate" Property="Stroke" Value="#CA78C0"/>
                            <Setter TargetName="CloseSignal" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
