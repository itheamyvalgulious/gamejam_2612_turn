; Procedural cyberpunk enemy character — studio project.
; Zero external assets: every mesh, material, shader and animation is code.

config_version=5

[application]

config/name="PROCEDURAL ENEMY STUDIO"
config/description="Code-generated cyberpunk enemy. No imported meshes or textures."
run/main_scene="res://scenes/studio.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.012, 0.012, 0.016, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.006, 0.007, 0.010, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2

[input]

cam_reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":70,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
