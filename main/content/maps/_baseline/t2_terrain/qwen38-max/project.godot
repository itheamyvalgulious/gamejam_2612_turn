; Engine configuration file.
; Godot 4.7.2 - Procedural Natural Terrain (10 km^2): snowfield / tropical rainforest / mountain cliffs + river valley
; 100% procedural: no external art assets. Geometry assembly + parametric surfaces + math-formula textures + custom shaders.

config_version=5

[application]

config/name="Procedural Terrain - Snow / Rainforest / Mountain River Valley"
config/description="A ~10 km^2 fully procedural natural terrain built in Godot 4.7.2. Three biomes (snowfield, tropical rainforest, mountain cliffs & river valley). All geometry, textures and materials are generated from math - no external assets."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=0
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_driver="vulkan"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.05, 0.07, 0.1, 1)
2d/snap/snap_2d_transforms_to_pixel=false
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/16_bits=false
